# =============================================================================
# LawTutor MCP - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# -- 국가법령정보센터 API --
# open.law.go.kr 에서 발급받은 API 인증키(OC)
LAW_GO_KR_OC=your_api_key_here

# -- 임베딩 모델 --
EMBEDDING_PROVIDER=bge_m3
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_M3_DEVICE=cpu                  # cpu 또는 cuda (GPU 있으면 cuda)

# -- Qdrant --
# Docker 환경: qdrant (컨테이너 서비스명)
# 로컬 개발: localhost
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# -- MCP 서버 --
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
# 32자 이상 랜덤 토큰 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LAWTUTOR_API_TOKEN=CHANGE_ME

# -- Cloudflare Tunnel --
# Cloudflare Zero Trust > Networks > Tunnels 에서 발급
# 로컬 개발 시에는 빈 값으로 두어도 됨 (cloudflared 서비스가 시작되지 않음)
TUNNEL_TOKEN=CHANGE_ME

# -- 데이터 경로 --
DATA_RAW_DIR=./data/raw
DATA_PARSED_DIR=./data/parsed

# -- 로깅 --
LOG_LEVEL=INFO

# -- Rate Limit --
RATE_LIMIT_PER_MINUTE=60
