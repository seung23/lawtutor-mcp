# =============================================================================
# LawTutor MCP - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# -- 국가법령정보센터 API --
# open.law.go.kr 에서 발급받은 OC (이메일 ID)
LAW_GO_KR_OC=your_email_id_here

# -- 임베딩 모델 --
EMBEDDING_PROVIDER=bge_m3
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_M3_DEVICE=cpu                  # cpu 또는 cuda (GPU 있으면 cuda)

# -- Qdrant --
QDRANT_HOST=qdrant                 # Docker 내부 네트워크 서비스명
QDRANT_PORT=6333

# -- MCP 서버 --
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
LAWTUTOR_API_TOKEN=CHANGE_ME       # 32자 이상 랜덤 토큰 (python -c "import secrets; print(secrets.token_urlsafe(32))")

# -- Cloudflare Tunnel --
TUNNEL_TOKEN=CHANGE_ME             # Cloudflare Zero Trust > Tunnels 에서 발급

# -- 데이터 경로 --
DATA_RAW_DIR=./data/raw
DATA_PARSED_DIR=./data/parsed

# -- 로깅 --
LOG_LEVEL=INFO

# -- Rate Limit --
RATE_LIMIT_PER_MINUTE=60
